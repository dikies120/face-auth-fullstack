generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  memberCode     String?        @unique
  name           String
  email          String?        @unique
  department     String?
  passwordHash   String?
  role           String         @default("MEMBER")
  faceDescriptor Json
  faceImageUrl   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attendances    Attendance[]
  loginLogs      FaceLoginLog[]

  @@map("users")
}

model Attendance {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  status             String   @default("ON_TIME")
  similarityDistance Float
  snapshotUrl        String?
  notes              String?
  createdAt          DateTime @default(now())

  @@map("attendances")
}

model FaceLoginLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  distance   Float
  isMatched  Boolean
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("face_login_logs")
}
